erDiagram
    usuario ||--o{ reserva : "realiza"
    usuario ||--o{ restaurante : "administra (admin_id)"
    restaurante ||--o{ mesa : "tiene"
    restaurante ||--o{ horario : "abre según"
    restaurante ||--o{ reserva : "recibe"
    mesa ||--o{ reserva : "se asigna a"
    restaurante ||--o{ categoria : "organiza su carta en"
    restaurante ||--o{ producto : "ofrece"
    categoria ||--o{ producto : "agrupa"
    reserva ||--o{ reserva_item : "pre-pedido (ON DELETE CASCADE)"
    producto ||--o{ reserva_item : "se pide en"
    usuario {
        INTEGER id PK
        TEXT nombre
        TEXT email UK
        TEXT password_hash
        TEXT rol "CHECK cliente|administrador"
    }
    restaurante {
        INTEGER id PK
        TEXT nombre
        TEXT direccion
        TEXT ciudad
        TEXT tipo_cocina
        TEXT descripcion
        INTEGER admin_id FK
    }
    mesa {
        INTEGER id PK
        INTEGER restaurante_id FK
        INTEGER numero "UK con restaurante_id"
        INTEGER capacidad "CHECK > 0"
        TEXT ubicacion
        INTEGER activa "CHECK 0|1"
    }
    horario {
        INTEGER id PK
        INTEGER restaurante_id FK
        INTEGER dia_semana "CHECK 0..6, UK con restaurante_id"
        TEXT hora_apertura
        TEXT hora_cierre "CHECK > apertura"
    }
    reserva {
        INTEGER id PK
        INTEGER usuario_id FK
        INTEGER restaurante_id FK
        INTEGER mesa_id FK
        TEXT fecha
        TEXT hora
        INTEGER num_personas "CHECK > 0"
        TEXT estado "CHECK PENDIENTE|CONFIRMADA|CANCELADA"
        TEXT notas
        TEXT creado_en
    }
    categoria {
        INTEGER id PK
        INTEGER restaurante_id FK
        TEXT nombre "UK con restaurante_id"
        INTEGER orden
    }
    producto {
        INTEGER id PK
        INTEGER restaurante_id FK
        INTEGER categoria_id FK
        TEXT nombre
        TEXT descripcion
        INTEGER precio_cop "CHECK >= 0 (COP enteros)"
        TEXT imagen
        INTEGER disponible "CHECK 0|1"
    }
    reserva_item {
        INTEGER id PK
        INTEGER reserva_id FK
        INTEGER producto_id FK
        INTEGER cantidad "CHECK > 0"
        INTEGER precio_unitario_cop "CHECK >= 0"
    }
